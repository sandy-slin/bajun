        "#root",
        "header",
        "nav"
      ],
      "performance_thresholds": {
        "load_time_ms": 3000,
        "first_paint_ms": 1500
      }
    },
    "dashboard": {
      "url": "http://localhost:3000/dashboard",
      "name": "仪表板",
      "checks": [
        "page_loads",
        "data_loads",
        "charts_render",
        "websocket_connects",
